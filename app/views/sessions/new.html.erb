<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(145deg, #0a1931 0%, #1b3a5c 40%, #6b2a5c 70%, #1b3a5c 100%);
    padding: 20px;
  }

  .login-container {
    max-width: 420px;
    width: 100%;
    background: rgba(10, 25, 49, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 40px;
    border-radius: 40px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  h2 {
    color: #f5e9d8;
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 25px;
    letter-spacing: 1px;
  }

  .campo {
    margin-bottom: 18px;
    text-align: left;
  }

  .campo label {
    color: #d4c4a8;
    font-weight: 500;
    font-size: 15px;
    display: block;
    margin-bottom: 6px;
  }

  .campo input {
    width: 100%;
    padding: 14px 18px;
    border-radius: 60px;
    border: none;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 16px;
    outline: 2px solid transparent;
    transition: 0.3s;
  }

  .campo input:focus {
    outline: 2px solid #f3b37e;
    background: rgba(255, 255, 255, 0.15);
  }

  .campo input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .btn-login {
    width: 100%;
    padding: 14px;
    background: linear-gradient(145deg, #f3b37e, #d48c5a);
    border: none;
    border-radius: 60px;
    font-weight: 700;
    font-size: 18px;
    color: #0b1a2e;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    margin-top: 8px;
  }

  .btn-login:hover {
    transform: scale(1.02);
    background: linear-gradient(145deg, #ffc89c, #e69b6a);
  }

  .enlace {
    color: #94b0c7;
    margin-top: 20px;
    font-size: 15px;
  }

  .enlace a {
    color: #f3b37e;
    text-decoration: none;
    font-weight: 500;
  }

  .enlace a:hover {
    text-decoration: underline;
  }

  .alert {
    background: rgba(255, 107, 107, 0.15);
    border: 1px solid #ff6b6b;
    padding: 12px;
    border-radius: 16px;
    margin-bottom: 20px;
    color: #ffb3b3;
    text-align: left;
  }
</style>

<div class="login-container">
  <h2>🔐 Iniciar Sesión</h2>

  <% if flash[:alert] %>
    <div class="alert">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: login_path, method: :post do %>
    <div class="campo">
      <label>Correo electrónico</label>
      <%= email_field_tag :email, nil, placeholder: "ejemplo@correo.com" %>
    </div>

    <div class="campo">
      <label>Contraseña</label>
      <%= password_field_tag :password, nil, placeholder: "••••••••" %>
    </div>

    <%= submit_tag "Entrar", class: "btn-login" %>
  <% end %>

  <div class="enlace">
    ¿No tienes cuenta? <%= link_to "Regístrate aquí", signup_path %>
  </div>
</div>