<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(145deg, #0a1931 0%, #1b3a5c 40%, #6b2a5c 70%, #1b3a5c 100%);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 20px;
  }

  .chat-container {
    max-width: 700px;
    width: 100%;
    background: rgba(13, 46, 96, 0.85);
    backdrop-filter: blur(12px);
    padding: 40px;
    border-radius: 50px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.36);
    border: 1px solid rgba(255, 255, 255, 0.21);
    text-align: center;
  }

  h1 {
    color: #f5e9d8;
    font-size: 2.4rem;
    margin-bottom: 5px;
  }

  .subtitulo {
    color: #d4c4a8;
    font-size: 1rem;
    margin-bottom: 25px;
  }

  .respuesta-bot {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 30px;
    padding: 20px 25px;
    margin: 15px 0;
    color: #f5e9d8;
    font-size: 1.1rem;
    line-height: 1.6;
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: left;
  }

  .respuesta-bot strong {
    color: #f3b37e;
  }

  .form-pregunta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
  }

  .form-pregunta input {
    padding: 14px 20px;
    border-radius: 60px;
    border: none;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1rem;
    outline: 2px solid transparent;
    transition: 0.3s;
  }

  .form-pregunta input:focus {
    outline: 2px solid #f3b37e;
    background: rgba(255, 255, 255, 0.15);
  }

  .form-pregunta input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .btn-enviar {
    padding: 14px;
    background: linear-gradient(145deg, #f3b37e, #d48c5a);
    border: none;
    border-radius: 60px;
    font-weight: 700;
    font-size: 1.1rem;
    color: #0b1a2e;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 8px 20px rgba(161, 37, 37, 0.3);
  }

  .btn-enviar:hover {
    transform: scale(1.02);
    background: linear-gradient(145deg, #ffc89c, #e69b6a);
  }

  .btn-volver {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 30px;
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 60px;
    color: #f5e9d8;
    text-decoration: none;
    transition: 0.3s;
  }

  .btn-volver:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #f3b37e;
  }
</style>

<div class="chat-container">
  <h1>🤖 FaroBot</h1>
  <p class="subtitulo">Tu amigo virtual que escucha, orienta y acompaña con el corazón 💬💖</p>

  <% if @respuesta.present? %>
    <div class="respuesta-bot">
      <p><strong>🤖 FaroBot:</strong> <%= @respuesta %></p>
    </div>
  <% else %>
    <div class="respuesta-bot">
      <strong>🤖 FaroBot:</strong><br>
      Hola, es un maravilloso día. Te puedo ayudar en algo. Puedes preguntarme tus dudas aquí estoy para ayudar y darte una mano amigable. ¿Comenzamos? 💬
    </div>
  <% end %>

  <%= form_with url: '/chatbot', method: :post, local: true, data: { turbo: false }, class: "form-pregunta" do %>
    <%= text_field_tag :pregunta, params[:pregunta], placeholder: "Escribe tu pregunta aquí...", required: true %>
    <%= submit_tag "Enviar ❤️", class: "btn-enviar" %>
  <% end %>

  <%= link_to "← Volver a la Zona de Niños", zone_path, class: "btn-volver" %>
</div>