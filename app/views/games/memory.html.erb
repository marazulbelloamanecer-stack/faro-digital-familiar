<style>
  body {
    background: linear-gradient(145deg, #0a1931, #1b3a5c);
    font-family: 'Segoe UI', sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
    padding: 20px;
  }
  .memory-container {
    max-width: 600px;
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
    padding: 30px;
    border-radius: 40px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.1);
  }
  h1 { color: #f5e9d8; font-size: 2rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 20px 0;
  }
  .card {
    background: #f3b37e;
    border-radius: 16px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    cursor: pointer;
    transition: 0.3s;
    color: #0b1a2e;
    font-weight: bold;
    user-select: none;
  }
  .card.flipped { background: #d4c4a8; }
  .card.matched { background: #22c55e; cursor: default; }
  .btn-volver {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 30px;
    background: transparent;
    border: 2px solid rgba(255,255,255,0.15);
    border-radius: 60px;
    color: #f5e9d8;
    text-decoration: none;
    transition: 0.3s;
  }
  .btn-volver:hover { background: rgba(255,255,255,0.05); border-color: #f3b37e; }
</style>

<div class="memory-container">
  <h1>🧠 Juego de Memoria</h1>
  <p style="color: #d4c4a8;">Encuentra las parejas de emojis</p>
  <div class="grid" id="memoryGrid"></div>
  <p id="estado" style="color: #f5e9d8; margin-top: 10px;">🔄 Encuentra todas las parejas</p>
  <%= link_to "← Volver a Zona de Niños", zone_path, class: "btn-volver" %>
</div>

<script>
  const emojis = ['🐶', '🐱', '🐭', '🐹', '🐰', '🦊', '🐻', '🐼'];
  let cards = [...emojis, ...emojis];
  let shuffled = [];
  let flipped = [];
  let matched = [];
  let lock = false;

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function render() {
    const grid = document.getElementById('memoryGrid');
    grid.innerHTML = '';
    shuffled.forEach((emoji, index) => {
      const card = document.createElement('div');
      card.className = 'card';
      card.dataset.index = index;
      if (flipped.includes(index) || matched.includes(index)) {
        card.textContent = emoji;
        if (matched.includes(index)) card.classList.add('matched');
        else card.classList.add('flipped');
      } else {
        card.textContent = '❓';
      }
      card.addEventListener('click', () => flipCard(index));
      grid.appendChild(card);
    });
    const estado = document.getElementById('estado');
    if (matched.length === emojis.length * 2) {
      estado.textContent = '🎉 ¡Ganaste! Todos los pares encontrados.';
    } else {
      estado.textContent = `🧩 Pares encontrados: ${matched.length / 2} de ${emojis.length}`;
    }
  }

  function flipCard(index) {
    if (lock) return;
    if (flipped.includes(index) || matched.includes(index)) return;
    flipped.push(index);
    if (flipped.length === 2) {
      lock = true;
      const [i1, i2] = flipped;
      if (shuffled[i1] === shuffled[i2] && i1 !== i2) {
        matched.push(i1, i2);
        flipped = [];
        lock = false;
        render();
      } else {
        setTimeout(() => {
          flipped = [];
          lock = false;
          render();
        }, 700);
      }
    }
    render();
  }

  shuffled = shuffle([...cards]);
  render();
</script>