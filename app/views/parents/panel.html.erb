<div style="max-width: 700px; margin: 50px auto; background: rgba(10, 25, 49, 0.85); padding: 40px; border-radius: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
  <h1 style="color: #f5e9d8; text-align: center;">👨‍👩‍👦 Panel de Padres</h1>
  <p style="color: #d4c4a8; text-align: center;">Bienvenido, <strong style="color: #f3b37e;"><%= @parent.name %></strong></p>

  <hr style="border-color: rgba(255,255,255,0.1); margin: 20px 0;">

  <h2 style="color: #f5e9d8; text-align: center;">Tus hijos</h2>

  <% if @parent.children.any? %>
    <ul style="list-style: none; padding: 0;">
      <% @parent.children.each do |child| %>
        <li style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 15px; margin-bottom: 10px; color: #f5e9d8;">
          🧒 <strong><%= child.name %></strong> - <%= child.age %> años
        </li>
      <% end %>
    </ul>
  <% else %>
    <p style="color: #94b0c7; text-align: center;">Aún no tienes hijos registrados.</p>
  <% end %>

  <!-- Botón agregar hijo -->
  <div style="text-align: center; margin-top: 20px;">
    <%= link_to "➕ Agregar hijo", new_child_path, style: "background: linear-gradient(145deg, #f3b37e, #d48c5a); padding: 14px 30px; border-radius: 60px; color: #0b1a2e; text-decoration: none; font-weight: 700; display: inline-block; box-shadow: 0 8px 20px rgba(0,0,0,0.3);" %>
  </div>

  <!-- Botón zona de niños -->
  <div style="text-align: center; margin-top: 15px;">
    <%= link_to "🧒 Zona de Niños", zone_path, style: "background: linear-gradient(145deg, #38bdf8, #0284c7); padding: 14px 30px; border-radius: 60px; color: #fff; text-decoration: none; font-weight: 700; display: inline-block; box-shadow: 0 8px 20px rgba(0,0,0,0.3);" %>
  </div>

  <!-- Botón cerrar sesión -->
  <div style="text-align: center; margin-top: 25px;">
    <%= link_to "🚪 Cerrar sesión", logout_path, data: { turbo_method: :delete }, style: "color: #f3b37e; text-decoration: none; font-weight: 500; padding: 12px 24px; border: 2px solid rgba(255,255,255,0.15); border-radius: 60px; display: inline-block; transition: 0.3s;" %>
  </div>
</div>